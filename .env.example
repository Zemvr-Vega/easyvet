# Copy this to .env and fill in your values
# ─────────────────────────────────────────

# MongoDB connection string
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Node environment
NODE_ENV=development

# ─── SMTP (Email Notifications) ──────────────────────────────────────
# Install nodemailer first: npm install nodemailer
# Leave blank to run in dev mode (emails logged to console only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=EasyVet <no-reply@easyvet.com>
APP_URL=http://localhost:3457
